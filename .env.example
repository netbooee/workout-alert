# ── iOS Shortcut sync authentication ──────────────────────────────────────────
# Generate a random secret and paste it into your iOS Shortcut as the x-api-key header
SYNC_API_KEY=your-random-secret-here

# ── Twilio SMS ─────────────────────────────────────────────────────────────────
# Create a free account at twilio.com, buy a $1/mo phone number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567   # your Twilio number

# Wife's phone number (E.164 format)
RECIPIENT_PHONE=+15559876543

# ── App URL (used in SMS links) ────────────────────────────────────────────────
# Set this to your Netlify site URL after deployment
APP_URL=https://your-app.netlify.app         # used by Twilio function
VITE_APP_URL=https://your-app.netlify.app    # used by the frontend native SMS

# Wife's phone for native iOS Messages (frontend-side, E.164 format)
VITE_RECIPIENT_PHONE=+15559876543
