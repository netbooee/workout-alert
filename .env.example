# Copy to .env.local and fill in from your Supabase project:
# Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key. Safe to ship in the app; RLS protects the data.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: Google sign-in. The iOS OAuth client ID from Google Cloud Console
# (Credentials → Create OAuth client ID → iOS, bundle ID com.netbooee.streaks).
# Leave empty to hide the Google button.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Push notifications: your EAS project ID (run `npx eas-cli@latest init` once).
EAS_PROJECT_ID=
