{
  "expo": {
    "name": "Sigamos",
    "slug": "sigamos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sigamos",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.netbooee.sigamos",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sigamos uses your photos so you can share workout check-ins with your accountability partners.",
          "cameraPermission": "Sigamos uses the camera so you can snap workout check-ins for your accountability partners.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Sigamos reads your workouts, steps, and heart rate to keep your weekly streak up to date and share progress with your crew.",
          "NSHealthUpdateUsageDescription": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "./plugins/with-scene-lifecycle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
